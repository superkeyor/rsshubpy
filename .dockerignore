# ---------- Secrets / env / mypy ----------
# NOTE: unlike .gitignore, .dockerignore patterns without "**/" only match
# at the ROOT of the build context. "**/" makes them match at any depth, so
# e.g. app/secret.py or app/.mypy_cache are excluded too, not just root copies.
.env
.env.*
!.env.example
**/local_settings.py
**/secret.py
**/pysecrets.py
**/.mypy_cache
**/.dmypy.json
**/dmypy.json

# ---------- Docker / compose ----------
docker-compose*.y*ml
Dockerfile*

# ---------- Local data / app state ----------
# runtime data: bind-mounted, never baked into the image
app/chromiumprofile/
app/cache/
# SeleniumBase writes these into its working directory (/app)
app/downloaded_files/
app/latest_logs/
tests/
README.md
AGENTS.md
upload/
run/
*.db
*.sqlite3
db.sqlite3-journal
**/*.log
instance/
.webassets-cache
.scrapy
celerybeat-schedule

# ---------- Build output ----------
# Remove any of these if your Dockerfile COPYs them in
# (e.g. a frontend built outside Docker, or prebuilt native libs).
build/
dist/
**/*.so

# ---------- Docs build output ----------
docs/_build
site

# ---------- VCS / editor ----------
.git
.gitignore
.dockerignore
.vscode/
.idea/

