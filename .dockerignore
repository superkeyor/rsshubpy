**/__pycache__
**/*.py[cod]
**/*$py.class
**/*.egg-info
*.egg
.eggs/
.Python
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.python-version
pip-log.txt
pip-delete-this-directory.txt

